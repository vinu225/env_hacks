# ==============================================================================
# Docker Ignore Configuration for Production Heat-Risk FastAPI Application
# ==============================================================================

# Version control & IDE
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo

# Environment variables & secrets (Strictly prevent baking secrets into image)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials*

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Offline ML Training Datasets & Exploration (Not needed in inference image)
ml/datasets/
ml/training/
ml/evaluation/
ml/pipelines/
ml/baselines/
data/
*.parquet
*.csv
*.ipynb

# DO NOT IGNORE ML ARTIFACTS
!ml/artifacts/heat_model_v1/

# Logs & Temporary files
*.log
logs/
tmp/
scratch/
docs/

# Decoupled Frontend (separate static/S3 deployment)
frontend/
