# ==============================================================================
# Environmental Intelligence Platform (Bharat Builds Tour - Track 02: Heat & Water)
# Environment Configuration Template
# ==============================================================================

# Application Core
ENVIRONMENT=development
APP_NAME=Environmental-Intelligence-Platform
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Providers & Integrations (Abstractions allow mock in dev/test, production providers in cloud)
WEATHER_PROVIDER_TYPE=mock
DECISION_PROVIDER_TYPE=mock
LLM_PROVIDER_TYPE=mock

# Model Inference Configuration
# Options: 'ml' (production LightGBM heat model) or 'rule_based' (deterministic baseline)
HEAT_MODEL_TYPE=ml
HEAT_MODEL_ARTIFACT_DIR=ml/artifacts/heat_model_v1

# External API Keys (Do NOT commit real keys; mock provider does not require keys)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
JEV_API_ENDPOINT=
JEV_API_KEY=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Storage & Database (memory for local dev/testing; dynamodb for AWS deployment)
STORAGE_BACKEND=memory
DYNAMODB_TABLE_LOCATIONS=bharat-env-locations
DYNAMODB_TABLE_RISKS=bharat-env-risk-predictions
DYNAMODB_TABLE_REPORTS=bharat-env-community-reports
S3_BUCKET_ARTIFACTS=bharat-env-ml-artifacts

# AWS Infrastructure Settings (Loaded from IAM role / AWS environment when deployed)
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
